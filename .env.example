# Copy to .env and fill in. Names only; never commit real values.
# Model id for the assistant, in litellm form (provider/model). No default.
RSI_MODEL=
# Model id that rewrites the harness in `rsi evolve`. No default.
RSI_IMPROVER_MODEL=
# Provider key for the models above (whichever provider the ids name).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
# TypeSafe System One (Jev): the harness watcher, and the pre-submit gate when RSI_GATE=1.
TYPESAFE_API_KEY=
# Optional: 1 turns the Jev pre-submit gate on for chat, run, evolve and test (default off: no measured benefit).
RSI_GATE=
# Optional: where runs/ and harnesses/ live (default: current directory).
RSI_HOME=
# Optional: read-only MathBench checkout for the second task family.
MATHBENCH_DIR=
# Optional: API port (default 8000). The web app needs NEXT_PUBLIC_API_BASE to match.
RSI_PORT=
